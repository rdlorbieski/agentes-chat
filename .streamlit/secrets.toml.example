# Copie para .streamlit/secrets.toml (rodando no seu computador) ou cole no campo
# Secrets do Streamlit Community Cloud. Nunca faça commit do secrets.toml.

# Obrigatórios
ANTHROPIC_API_KEY = "sk-ant-api03-..."
GITHUB_TOKEN = "github_pat_..."
