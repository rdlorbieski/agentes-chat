# Copie para .env na VPS (cp .env.example .env) e preencha. Nunca faça commit do .env.

# Obrigatórios
ANTHROPIC_API_KEY=sk-ant-api03-...
GITHUB_TOKEN=github_pat_...

# Login do chat. Sem estas linhas, vale o padrão admin / chat-agentes.
APP_USUARIO=admin
APP_SENHA=chat-agentes

# Opcionais (os valores abaixo são os padrões)
# MODELO=claude-opus-5-5
# ESFORCO=medium
# REPO_FITAME=rdlorbieski/fitame-agentes
# REPO_CIGA=rdlorbieski/ciga-agentes
